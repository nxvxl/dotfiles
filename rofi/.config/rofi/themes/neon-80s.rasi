/* 80s NEON / SYNTHWAVE THEME FOR ROFI */

* {
    font: "JetBrainsMono Nerd Font 16";

    bg0:    #0d0221E6;
    bg1:    #1a0b2eE6;
    bg2:    #b026ffe6;

    pink:    #ff2a6d;
    purple:  #b026ff;
    cyan:    #05d9e8;
    magenta: #d300c5;
    yellow:  #fee440;
    ice:     #d1f7ff;
    dim:     #6c5b8a;

    fg0:    @ice;
    fg1:    @bg0;
    fg2:    @dim;

    background-color: transparent;
    text-color:       @fg0;

    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    background-color: @bg0;

    border:        3;
    border-color:  @purple;
    border-radius: 10;

    location: center;
    width:    640;
}

inputbar {
    padding:  12px;
    spacing:  12px;
    children: [ icon-search, entry ];
}

icon-search {
    expand:   false;
    filename: "search";
    size:     28px;
}

icon-search, entry, element-icon, element-text {
    vertical-align: 0.5;
}

entry {
    font: inherit;

    placeholder:       "Search";
    placeholder-color: @fg2;
    text-color:        @cyan;
}

message {
    border:           2px 0 0;
    border-color:     @magenta;
    background-color: @bg1;
}

textbox {
    padding: 8px 24px;
}

listview {
    lines:   10;
    columns: 1;

    fixed-height: false;
    border:       1px 0 0;
    border-color: @magenta;
}

element {
    padding:          8px 16px;
    spacing:          16px;
    background-color: transparent;
}

element normal.normal {
    background-color: transparent;
    text-color:       @ice;
}

element alternate.normal {
    background-color: @bg1;
    text-color:       @ice;
}

element normal active {
    background-color: transparent;
    text-color:       @cyan;
}

element alternate active {
    background-color: @bg1;
    text-color:       @cyan;
}

element normal urgent,
element alternate urgent {
    text-color: @pink;
}

element selected.normal,
element selected.active {
    background-color: @bg2;
    text-color:       #0d0221;
}

element-icon {
    size: 1em;
}

element-text {
    text-color: inherit;
}
