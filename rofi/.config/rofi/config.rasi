/* WINDOWS XP (LUNA) THEME FOR ROFI */

* {
    font: "JetBrainsMono Nerd Font 16";

    xp-title:       #0058ee;
    xp-title-light: #3a93ff;
    xp-face:        #ece9d8;
    xp-white:       #ffffff;
    xp-text:        #000000;
    xp-shadow:      #aca899;
    xp-dark-shadow: #716f64;
    xp-border:      #7f9db9;
    xp-select:      #316ac5;
    xp-select-alt:  #4a8ef5;
    xp-light:       #f5f4ea;
    xp-disabled:    #808080;
    xp-alert:       #cc0000;

    background-color: transparent;
    text-color:       @xp-text;

    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    background-color: @xp-face;

    border:        2px;
    border-color:  @xp-title;
    border-radius: 0;

    location: center;
    width:    640;
}

inputbar {
    background-color: @xp-title;
    padding:  6px;
    spacing:  8px;
    children: [ icon-search, entry ];
}

icon-search {
    expand:   false;
    filename: "search";
    size:     24px;
}

icon-search, entry, element-icon, element-text {
    vertical-align: 0.5;
}

entry {
    font: "JetBrainsMono Nerd Font 16";

    padding: 4px 6px;

    background-color: @xp-white;
    text-color:       @xp-text;

    placeholder:       "Type to search...";
    placeholder-color: @xp-disabled;

    border:        1px;
    border-color:  @xp-border;
    border-radius: 0;
}

message {
    background-color: @xp-face;
    border:           1px 0 0;
    border-color:     @xp-shadow;
}

textbox {
    text-color: @xp-text;
    padding:    8px 16px;
}

listview {
    background-color: @xp-white;

    lines:   10;
    columns: 1;

    fixed-height: false;
    border:       1px 0 0;
    border-color: @xp-border;
    padding:      2px;
}

element {
    padding:          5px 8px;
    spacing:          8px;
    background-color: transparent;
    text-color:       @xp-text;
}

element normal.normal {
    background-color: @xp-white;
    text-color:       @xp-text;
}

element alternate.normal {
    background-color: @xp-light;
    text-color:       @xp-text;
}

element normal active {
    background-color: @xp-light;
    text-color:       @xp-text;
}

element alternate active {
    background-color: @xp-white;
    text-color:       @xp-text;
}

element normal urgent,
element alternate urgent {
    text-color: @xp-alert;
}

element selected.normal,
element selected.active {
    background-color: @xp-select;
    text-color:       @xp-white;
}

element-icon {
    size: 1em;
}

element-text {
    text-color: inherit;
}

scrollbar {
    width:            12px;
    background-color: @xp-face;
    border-left:      1px;
    border-color:     @xp-shadow;
}

handle {
    background-color: @xp-select;
    border:           1px;
    border-color:     @xp-title;
    border-radius:    0;
}
